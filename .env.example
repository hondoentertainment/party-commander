# Supabase (required for auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Restrict app access to specific email domains (comma-separated)
# VITE_ALLOWED_EMAIL_DOMAINS=company.com,gmail.com

# Optional: Admin access – only these emails can see and use the Admin module (comma-separated)
# VITE_ADMIN_EMAILS=admin@company.com,owner@party.com

# Optional: App base path (e.g. /party/ for GitHub Pages)
# VITE_BASE=/

# ── API Server ──────────────────────────────────────────
# Supabase service role key (required for API server admin access)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API key for external project authentication (generate a random secret)
# API_SECRET_KEY=your-api-secret-key

# API server port (default: 3001)
# PORT=3001
